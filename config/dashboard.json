                "annotations": {
                    "horizontal": [
                        {
                            "value": 0.5,
                            "label": "P95 SLO",
                            "fill": "above",
                            "color": "#ff7f0e"
                        },
                        {
                            "value": 1,
                            "label": "P99 SLO",
                            "fill": "above",
                            "color": "#d13212"
                        }
                    ]
                },
                "stat": "p99"
            }
        },
        {
            "type": "metric",
