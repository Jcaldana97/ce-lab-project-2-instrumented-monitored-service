                "title": "Errors - HTTP Status Codes",
                "view": "timeSeries",
                "stacked": true,
                "region": "us-east-1",
                "period": 60,
                "stat": "Sum"
            }
        },
        {
            "type": "metric",
            "x": 0,
            "y": 11,
            "width": 12,
            "height": 6,
            "properties": {
                "metrics": [
                    [
                        "AWS/ApplicationELB",
                        "TargetResponseTime",
                        "LoadBalancer",
                        "app/logging-p2-alb/7c4aa27ebf3935b4",
