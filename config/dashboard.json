                            "stat": "p50",
                            "label": "P50",
                            "region": "us-east-1"
                        }
                    ],
                    [
                        "...",
                        {
                            "stat": "p95",
                            "label": "P95",
                            "region": "us-east-1"
                        }
                    ],
                    [
                        "...",
                        {
                            "label": "P99",
